{
  "_README": [
    "RiMCP 检索评测集（L1 检索层，确定性指标，不用 LLM）。",
    "expected 中的每一项匹配 itemId / symbolId，或作为 symbolId 的后缀（'Need_Food' 可匹配 'RimWorld.Need_Food'）。",
    "expected 来源：先用 tools/Resolve-SymbolIds.ps1 在源码树里核对真实 symbolId，再用 bench 的 missingExpected 复核。",
    "holdout=true 的 10 条不参与调参，只用于防过拟合的最终验收。",
    "类别：exact-symbol(8) / def-name(8) / natural-language(8) / cross-layer(8) / bilingual-mod(8)"
  ],
  "version": 1,
  "createdAt": "2026-09-17",
  "queries": [
    {
      "id": "ex01",
      "query": "Need_Food",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["RimWorld.Need_Food"],
      "note": "精确类型名。语义路在纯符号名查询上天然弱，是 1.3 混合检索的主要受益点。"
    },
    {
      "id": "ex02",
      "query": "CompPowerTrader",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["RimWorld.CompPowerTrader"],
      "note": "精确类型名"
    },
    {
      "id": "ex03",
      "query": "Pawn_HealthTracker",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["Verse.Pawn_HealthTracker"],
      "note": "精确类型名；注意命名空间是 Verse 不是 RimWorld",
      "holdout": true
    },
    {
      "id": "ex04",
      "query": "JobDriver_Mine",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["RimWorld.JobDriver_Mine"],
      "note": "精确类型名"
    },
    {
      "id": "ex05",
      "query": "GenRecipe",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["Verse.GenRecipe"],
      "note": "精确类型名"
    },
    {
      "id": "ex06",
      "query": "ThingDef",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["Verse.ThingDef"],
      "note": "核心类型；高频词，考验排序是否把定义本体排在引用它的地方之前"
    },
    {
      "id": "ex07",
      "query": "StatWorker_MeleeDamageAmount",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["RimWorld.StatWorker_MeleeDamageAmount"],
      "note": "长 snake_case 名字",
      "holdout": true
    },
    {
      "id": "ex08",
      "query": "HediffComp_Disappears",
      "kind": "cs",
      "category": "exact-symbol",
      "expected": ["Verse.HediffComp_Disappears"],
      "note": "精确类型名"
    },

    {
      "id": "df01",
      "query": "Steel",
      "kind": "xml",
      "category": "def-name",
      "expected": ["xml:ThingDef:Steel"],
      "note": "Def 名；高频短词，考验 Def 本体是否排在引用它的 XML 之前"
    },
    {
      "id": "df02",
      "query": "MealSimple",
      "kind": "xml",
      "category": "def-name",
